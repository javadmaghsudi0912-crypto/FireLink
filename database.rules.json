{
  "rules": {
    "teams": {
      "$teamId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        "members": {
          "$uid": {
            ".write": "auth != null && root.child('teams').child($teamId).child('members').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.hasChildren(['displayName','role']) && newData.child('displayName').isString() && newData.child('displayName').val().length <= 100 && newData.child('role').isString() && (newData.child('role').val() === 'admin' || newData.child('role').val() === 'member')",
            "$other": { ".validate": false }
          }
        },
        "incidents": {
          ".indexOn": ["createdAt"],
          "$incidentId": {
            ".write": "auth != null && root.child('teams').child($teamId).child('members').child(auth.uid).exists() && !data.exists() && newData.child('creatorUid').val() === auth.uid && !newData.child('acks').exists()",
            ".validate": "newData.hasChildren(['latitude','longitude','createdAt','createdBy','creatorUid','unitName','status'])",
            "latitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "longitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "createdBy": { ".validate": "newData.isString()" },
            "creatorUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "unitName": { ".validate": "newData.isString()" },
            "status": { ".validate": "newData.isString()" },
            "acks": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('teams').child($teamId).child('members').child(auth.uid).exists()"
              }
            },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "joinRequests": {
      "$teamId": {
        ".read": "auth != null && root.child('teams').child($teamId).child('members').child(auth.uid).child('role').val() === 'admin'",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('teams').child($teamId).child('members').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid','displayName','email','teamId','createdAt']) && newData.child('uid').val() === $uid && newData.child('teamId').val() === $teamId && newData.child('displayName').isString() && newData.child('displayName').val().length > 1 && newData.child('displayName').val().length <= 100 && newData.child('email').isString() && newData.child('email').val().length <= 200 && newData.child('createdAt').isNumber())",
          "$other": { ".validate": false }
        }
      }
    }
  }
}
